{
  "name": "tabryn",
  "version": "0.1.0",
  "description": "Universal browser runtime for AI agents — control, inspect, test, and debug through your existing Chrome tabs and sessions via MCP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tabryn": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "extension"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');const p=require('path');const d='./dist';if(fs.existsSync(d)){fs.rmSync(d,{recursive:true,force:true});console.log('cleaned dist/')}\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "browser-automation",
    "browser-agent",
    "chrome-extension",
    "developer-tools",
    "coding-agents",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^13.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.25.0",
    "globals": "^17.8.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
